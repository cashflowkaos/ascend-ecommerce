// ============================================================
// ASCEND PEPTIDE CO.
// Core Ecommerce / Membership Database
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  MEMBER
  ADMIN
}

enum BackOfficeInvoiceStatus {
  OPEN
  COMPLETED
  VOID
}

enum BackOfficeInvoiceSource {
  POS
  WEBSITE
  LEGACY_IMPORT
}

enum BackOfficeSellUnit {
  UNIT
  KIT
}

enum BackOfficePaymentMethod {
  CASH
  ZELLE
}

enum BackOfficePaymentType {
  PAYMENT
  REFUND
}

enum MemberStatus {
  PENDING
  APPROVED
  DISABLED
  DECLINED
}

enum DistroTier {
  TIER_1
  TIER_2
  TIER_3
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  SHIPPING
  PICKUP
}

enum OrderPaymentMethod {
  CASH
  ZELLE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum InventoryMovementType {
  INITIAL
  RECEIVED
  SOLD
  ADJUSTMENT
  RETURNED
  DAMAGED
}

enum BackOfficeCustomerPricingType {
  RETAIL
  WHOLESALE
  TIER_1
  TIER_2
  TIER_3
}

enum BackOfficeInventoryType {
  BATCHED
  SIMPLE
  NON_INVENTORY
}

enum BackOfficeBatchStatus {
  ACTIVE
  RETIRED
}

enum BackOfficeInventoryMovementType {
  INITIAL
  RECEIVED
  SOLD
  RETURNED
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGED
}

enum BackOfficePurchaseUnit {
  UNIT
  KIT
}

enum BackOfficePurchaseOrderStatus {
  DRAFT
  ORDERED
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum BackOfficeTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MessageThreadStatus {
  OPEN
  CLOSED
}

// ============================================================
// USERS / MEMBERS
// ============================================================

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?

  role          UserRole     @default(MEMBER)
  status        MemberStatus @default(PENDING)
  distroEnabled Boolean      @default(false)
  distroTier    DistroTier?
  approvedAt    DateTime?
  disabledAt    DateTime?
  lastLoginAt   DateTime?

  dateOfBirth        DateTime?
  ageCertifiedAt     DateTime?
  mustChangePassword Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             Session[]
  addresses            Address[]
  orders               Order[]
  messageThreads       MessageThread[]
  messages             Message[]
  orderActivities      OrderActivity[]
  pickupAvailability   PickupAvailability? @relation(fields: [pickupAvailabilityId], references: [id])
  pickupAvailabilityId String?

  backOfficeCustomer BackOfficeCustomer?

  @@index([status])
  @@index([role])
  @@index([lastName, firstName])
}

// ============================================================
// AUTH SESSIONS
// ============================================================

model Session {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// MEMBER ADDRESSES
// ============================================================

model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      String? @default("Shipping")
  firstName  String
  lastName   String
  company    String?
  address1   String
  address2   String?
  city       String
  state      String
  postalCode String
  country    String  @default("US")
  phone      String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id String @id @default(cuid())

  slug String  @unique
  sku  String? @unique

  name     String
  strength String
  category String

  image String?

  overview     String @db.Text
  composition  Json?
  presentation String
  storage      String

  researchNotice String? @db.Text

  memberPrice Decimal? @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)

  featured    Boolean @default(false)
  active      Boolean @default(true)
  purchasable Boolean @default(false)

  trackInventory Boolean @default(true)
  inventoryQty   Int     @default(0)
  lowStockAt     Int     @default(5)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  literature     ProductLiterature[]
  variants       ProductVariant[]
  inventoryMoves InventoryMovement[]
  orderItems     OrderItem[]

  @@index([active])
  @@index([featured])
  @@index([category])
}

// ============================================================
// PRODUCT VARIANTS
// ============================================================

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems     OrderItem[]
  inventoryMoves InventoryMovement[]

  strength String
  sku      String? @unique

  memberPrice Decimal? @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)

  inventoryQty Int @default(0)
  lowStockAt   Int @default(5)

  active      Boolean @default(true)
  purchasable Boolean @default(false)

  sortOrder Int @default(0)

  backOfficeProductId String?
  backOfficeProduct   BackOfficeProduct? @relation(fields: [backOfficeProductId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, strength])
  @@index([productId])
  @@index([active])
  @@index([purchasable])
}

// ============================================================
// PRODUCT LITERATURE
// ============================================================

model ProductLiterature {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title   String
  journal String
  year    Int
  type    String
  url     String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ============================================================
// INVENTORY HISTORY
// ============================================================

model InventoryMovement {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  type InventoryMovementType

  quantity       Int
  quantityBefore Int
  quantityAfter  Int

  note      String?
  createdBy String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

// ============================================================
// ORDERS
// ============================================================

enum OrderChannel {
  RETAIL
  DISTRO
  MIXED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status            OrderStatus         @default(PENDING)
  paymentStatus     PaymentStatus       @default(UNPAID)
  paymentMethod     OrderPaymentMethod?
  zelleConfirmation String?
  paidAt            DateTime?
  channel           OrderChannel        @default(RETAIL)

  subtotal       Decimal @db.Decimal(10, 2)
  shippingAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  shippingFirstName  String
  shippingLastName   String
  shippingCompany    String?
  shippingAddress1   String
  shippingAddress2   String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String  @default("US")
  shippingPhone      String?

  customerNote String? @db.Text
  adminNote    String? @db.Text

  fulfillmentMethod FulfillmentMethod?

  pickupScheduledAt DateTime?
  pickupConfirmedAt DateTime?
  pickupAddress1    String?
  pickupAddress2    String?
  pickupCity        String?
  pickupState       String?
  pickupPostalCode  String?

  trackingNumber String?
  shippedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              OrderItem[]
  orderActivities    OrderActivity[]
  pickupAvailability PickupAvailability?

  backOfficeInvoice BackOfficeInvoice?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// ORDER ITEMS
// ============================================================

model OrderActivity {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  action  String
  details String? @db.Text

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([adminId])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  sku         String?
  strength    String

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ============================================================
// MEMBER / ADMIN MESSAGING
// ============================================================

model MessageThread {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String
  status  MessageThreadStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([userId])
  @@index([status])
  @@index([updatedAt])
}

model Message {
  id String @id @default(cuid())

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  body   String    @db.Text
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================================
// PUBLIC CONTACT INQUIRIES
// ============================================================

model ContactInquiry {
  id String @id @default(cuid())

  firstName String
  lastName  String?
  email     String
  phone     String?
  subject   String?
  message   String  @db.Text

  readAt     DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([readAt])
}

// ============================================================
// MEMBER BROADCASTS / ANNOUNCEMENTS
// ============================================================

model MessageBroadcast {
  id String @id @default(cuid())

  recipientCount Int @default(0)

  sentById    String
  sentByName  String
  sentByEmail String

  emailSuccessCount Int @default(0)
  emailFailureCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DistroProduct {
  id          String @id @default(cuid())
  sku         String @unique
  name        String
  description String

  cost       Decimal? @db.Decimal(10, 2)
  tier1Price Decimal? @db.Decimal(10, 2)
  tier2Price Decimal? @db.Decimal(10, 2)
  tier3Price Decimal? @db.Decimal(10, 2)

  inventoryQty Int     @default(0)
  enabled      Boolean @default(true)
  available    Boolean @default(true)
  sortOrder    Int     @default(0)

  batches DistroBatch[]

  backOfficeProductId String?            @unique
  backOfficeProduct   BackOfficeProduct? @relation(fields: [backOfficeProductId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([enabled, sortOrder])
}

model DistroBatch {
  id String @id @default(cuid())

  productId String
  product   DistroProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchNumber String

  createdAt DateTime @default(now())

  @@unique([productId, batchNumber])
  @@index([productId])
}

model PickupAvailability {
  id       String   @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  bookedOrderId String? @unique
  bookedOrder   Order?  @relation(fields: [bookedOrderId], references: [id], onDelete: SetNull)

  manualReservationName    String?
  manualReservationPhone   String?
  manualReservationNote    String?
  manualReservationType    String?
  manualReservationGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([startsAt])
  @@index([isActive])
}

// ============================================================
// BACK OFFICE
// Independent operational inventory system
// ============================================================

model BackOfficeProduct {
  id String @id @default(cuid())

  sku         String @unique
  name        String
  description String

  cost           Decimal? @db.Decimal(10, 2)
  retailPrice    Decimal? @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)
  tier1Price     Decimal? @db.Decimal(10, 2)
  tier2Price     Decimal? @db.Decimal(10, 2)
  tier3Price     Decimal? @db.Decimal(10, 2)

  unitsPerKit   Int                     @default(10)
  inventoryType BackOfficeInventoryType @default(BATCHED)

  // Legacy production column retained for backward-compatible schema changes.
  // Retail storefront does not use this field.
  displayRetail Boolean @default(false)
  displayDistro Boolean @default(false)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches                  BackOfficeBatch[]
  simpleBalances           BackOfficeSimpleInventoryBalance[]
  simpleMovements          BackOfficeSimpleInventoryMovement[]
  simpleTransfers          BackOfficeSimpleInventoryTransfer[]
  simpleInvoiceAllocations BackOfficeInvoiceItemSimpleAllocation[]
  distroProduct            DistroProduct?
  retailVariants           ProductVariant[]
  invoiceItems             BackOfficeInvoiceItem[]
  purchaseOrderItems       BackOfficePurchaseOrderItem[]
  purchaseReceiptItems     BackOfficePurchaseReceiptItem[]

  @@index([name])
  @@index([active, sortOrder])
}

model BackOfficeBatch {
  id String @id @default(cuid())

  productId String
  product   BackOfficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  batchNumber String
  status      BackOfficeBatchStatus @default(ACTIVE)

  receivedAt DateTime  @default(now())
  retiredAt  DateTime?

  coaUrl        String?
  coaUploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances             BackOfficeInventoryBalance[]
  movements            BackOfficeInventoryMovement[]
  transfers            BackOfficeInventoryTransfer[]
  invoiceAllocations   BackOfficeInvoiceItemAllocation[]
  purchaseReceiptItems BackOfficePurchaseReceiptItem[]

  @@unique([productId, batchNumber])
  @@index([productId, status])
  @@index([batchNumber])
  @@index([productId, receivedAt])
}

model BackOfficeLocation {
  id String @id @default(cuid())

  code String @unique
  name String

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances                           BackOfficeInventoryBalance[]
  movements                          BackOfficeInventoryMovement[]
  transfersFrom                      BackOfficeInventoryTransfer[]           @relation("BackOfficeTransferFrom")
  transfersTo                        BackOfficeInventoryTransfer[]           @relation("BackOfficeTransferTo")
  invoices                           BackOfficeInvoice[]
  invoiceAllocations                 BackOfficeInvoiceItemAllocation[]
  backOfficeSimpleInventoryBalances  BackOfficeSimpleInventoryBalance[]
  backOfficeSimpleInventoryMovements BackOfficeSimpleInventoryMovement[]
  simpleTransfersFrom                BackOfficeSimpleInventoryTransfer[]     @relation("BackOfficeSimpleTransferFrom")
  simpleTransfersTo                  BackOfficeSimpleInventoryTransfer[]     @relation("BackOfficeSimpleTransferTo")
  invoiceItemSimpleAllocations       BackOfficeInvoiceItemSimpleAllocation[]
  purchaseReceipts                   BackOfficePurchaseReceipt[]

  @@index([active, sortOrder])
}

model BackOfficeInventoryBalance {
  id String @id @default(cuid())

  batchId String
  batch   BackOfficeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, locationId])
  @@index([locationId])
  @@index([batchId])
}

model BackOfficeSimpleInventoryBalance {
  id String @id @default(cuid())

  productId String
  product   BackOfficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model BackOfficeInventoryMovement {
  id String @id @default(cuid())

  batchId String
  batch   BackOfficeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  type BackOfficeInventoryMovementType

  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int

  referenceType String?
  referenceId   String?
  note          String?

  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model BackOfficeInventoryTransfer {
  id String @id @default(cuid())

  batchId String
  batch   BackOfficeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  fromLocationId String
  fromLocation   BackOfficeLocation @relation("BackOfficeTransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)

  toLocationId String
  toLocation   BackOfficeLocation @relation("BackOfficeTransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)

  quantity Int

  status BackOfficeTransferStatus @default(PENDING)

  note String?

  createdById   String?
  createdByName String?

  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([createdAt])
}

model BackOfficeSimpleInventoryTransfer {
  id String @id @default(cuid())

  productId String
  product   BackOfficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  fromLocationId String
  fromLocation   BackOfficeLocation @relation("BackOfficeSimpleTransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)

  toLocationId String
  toLocation   BackOfficeLocation @relation("BackOfficeSimpleTransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)

  quantity Int

  status BackOfficeTransferStatus @default(PENDING)

  note String?

  createdById   String?
  createdByName String?

  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([createdAt])
}

model BackOfficeCustomer {
  id String @id @default(cuid())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  legacyCustomerId Int? @unique

  firstName String
  lastName  String
  company   String?

  email String?
  phone String?

  pricingType BackOfficeCustomerPricingType @default(RETAIL)

  notes  String? @db.Text
  active Boolean @default(true)

  invoices BackOfficeInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([email])
  @@index([phone])
  @@index([pricingType])
  @@index([active])
}

model BackOfficeInvoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  source BackOfficeInvoiceSource @default(POS)
  status BackOfficeInvoiceStatus @default(OPEN)

  customerId String
  customer   BackOfficeCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  customerFirstName String
  customerLastName  String
  customerCompany   String?
  customerEmail     String?
  customerPhone     String?
  pricingType       BackOfficeCustomerPricingType

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  locationCode String
  locationName String

  websiteOrderId String? @unique
  websiteOrder   Order?  @relation(fields: [websiteOrderId], references: [id], onDelete: SetNull)

  legacySaleId Int? @unique

  subtotal Decimal @default(0) @db.Decimal(10, 2)

  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2)

  taxAmount Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @default(0) @db.Decimal(10, 2)

  amountPaid Decimal @default(0) @db.Decimal(10, 2)
  balanceDue Decimal @default(0) @db.Decimal(10, 2)

  customerNote String? @db.Text
  internalNote String? @db.Text

  createdById   String?
  createdByName String?

  completedAt DateTime?

  voidedAt     DateTime?
  voidedById   String?
  voidedByName String?
  voidReason   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    BackOfficeInvoiceItem[]
  payments BackOfficeInvoicePayment[]

  @@index([customerId])
  @@index([locationId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([customerLastName, customerFirstName])
  @@index([customerEmail])
  @@index([customerPhone])
}

model BackOfficeInvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   BackOfficeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  productId String?
  product   BackOfficeProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sku         String?
  productName String

  sellUnit BackOfficeSellUnit
  quantity Int

  unitsPerSellUnit Int
  baseUnitsTotal   Int

  standardUnitPrice Decimal @db.Decimal(10, 2)
  unitPrice         Decimal @db.Decimal(10, 2)
  lineTotal         Decimal @db.Decimal(10, 2)

  priceAdjusted Boolean @default(false)

  priceAdjustmentReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations       BackOfficeInvoiceItemAllocation[]
  simpleAllocations BackOfficeInvoiceItemSimpleAllocation[]

  @@index([invoiceId])
  @@index([productId])
  @@index([sku])
}

model BackOfficeInvoicePayment {
  id String @id @default(cuid())

  invoiceId String
  invoice   BackOfficeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  type   BackOfficePaymentType   @default(PAYMENT)
  method BackOfficePaymentMethod
  amount Decimal                 @db.Decimal(10, 2)

  zelleReference String?
  note           String? @db.Text

  receivedById   String?
  receivedByName String?
  receivedAt     DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([method])
  @@index([receivedAt])
}

model BackOfficeInvoiceItemAllocation {
  id String @id @default(cuid())

  invoiceItemId String
  invoiceItem   BackOfficeInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  batchId String
  batch   BackOfficeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())

  @@index([invoiceItemId])
  @@index([batchId])
  @@index([locationId])
}

model BackOfficeSimpleInventoryMovement {
  id String @id @default(cuid())

  productId String
  product   BackOfficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  type BackOfficeInventoryMovementType

  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int

  referenceType String?
  referenceId   String?
  note          String?

  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model BackOfficeInvoiceItemSimpleAllocation {
  id String @id @default(cuid())

  invoiceItemId String
  invoiceItem   BackOfficeInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  productId String
  product   BackOfficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())

  @@index([invoiceItemId])
  @@index([productId])
  @@index([locationId])
}

model BackOfficeSupplier {
  id String @id @default(cuid())

  name        String
  contactName String?
  email       String?
  phone       String?
  website     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  notes String? @db.Text

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders BackOfficePurchaseOrder[]

  @@index([name])
  @@index([active, name])
}

model BackOfficePurchaseOrder {
  id String @id @default(cuid())

  poNumber String @unique

  supplierId String
  supplier   BackOfficeSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  status BackOfficePurchaseOrderStatus @default(DRAFT)

  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  shippedDate  DateTime?
  receivedDate DateTime?

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  shipping   Decimal @default(0) @db.Decimal(12, 2)
  otherCosts Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @default(0) @db.Decimal(12, 2)

  supplierReference String?
  trackingNumber    String?
  notes             String? @db.Text

  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    BackOfficePurchaseOrderItem[]
  receipts BackOfficePurchaseReceipt[]

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([createdAt])
}

model BackOfficePurchaseOrderItem {
  id String @id @default(cuid())

  purchaseOrderId String
  purchaseOrder   BackOfficePurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  productId String
  product   BackOfficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName      String
  productSku       String
  inventoryType    BackOfficeInventoryType
  unitsPerKit      Int
  purchaseUnit     BackOfficePurchaseUnit  @default(UNIT)
  quantityOrdered  Int
  quantityReceived Int                     @default(0)

  unitCost  Decimal @db.Decimal(12, 4)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receiptItems BackOfficePurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model BackOfficePurchaseReceipt {
  id String @id @default(cuid())

  purchaseOrderId String
  purchaseOrder   BackOfficePurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  locationId String
  location   BackOfficeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  receivedAt DateTime @default(now())

  note String? @db.Text

  receivedById   String?
  receivedByName String?

  voidedAt     DateTime?
  voidedById   String?
  voidedByName String?
  voidReason   String?   @db.Text

  createdAt DateTime @default(now())

  items BackOfficePurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([locationId])
  @@index([receivedAt])
  @@index([createdAt])
}

model BackOfficePurchaseReceiptItem {
  id String @id @default(cuid())

  receiptId String
  receipt   BackOfficePurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  purchaseOrderItemId String
  purchaseOrderItem   BackOfficePurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  productId String
  product   BackOfficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  inventoryType BackOfficeInventoryType

  quantityReceived Int

  batchId String?
  batch   BackOfficeBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  batchNumber String?

  physicalUnitCost Decimal? @db.Decimal(12, 4)

  createdAt DateTime @default(now())

  @@index([receiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@index([batchId])
}

model BackOfficeExpense {
  id String @id @default(cuid())

  expenseDate DateTime @default(now())

  category    String
  vendor      String?
  description String?

  amount Decimal @db.Decimal(12, 2)

  paidFrom String?
  notes    String? @db.Text

  legacySource String?
  legacyId     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([legacySource, legacyId])
  @@index([expenseDate])
  @@index([category])
  @@index([vendor])
  @@index([createdAt])
}

model BackOfficeReconciliation {
  id String @id @default(cuid())

  weekEnding DateTime

  actualCash  Decimal @db.Decimal(12, 2)
  actualBank  Decimal @db.Decimal(12, 2)
  actualFunds Decimal @db.Decimal(12, 2)

  recordedSales    Decimal @db.Decimal(12, 2)
  recordedExpenses Decimal @db.Decimal(12, 2)
  recordedNet      Decimal @db.Decimal(12, 2)

  openingFunds  Decimal? @db.Decimal(12, 2)
  adjustments   Decimal? @db.Decimal(12, 2)
  expectedFunds Decimal? @db.Decimal(12, 2)

  variance Decimal @db.Decimal(12, 2)

  note String? @db.Text

  reconciledById   String?
  reconciledByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekEnding])
  @@index([createdAt])
}
